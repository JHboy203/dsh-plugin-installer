{
  "name": "dsh-plugin-installer",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "DSH 侧边栏「插件/Skill 安装面板」：把 GitHub 链接、Release、.tgz/.zip 直链或本地压缩包丢进来，宿主侧确定性完成下载 → 解包 → 识别 → 安全预检 → 安装 → 快照/回滚 → 诊断；安装执行零 token，AI 只能推荐与提交请求。",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin-installer",
    "skill-installer",
    "panel",
    "installer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JHboy203/dsh-plugin-installer.git"
  },
  "homepage": "https://github.com/JHboy203/dsh-plugin-installer#readme",
  "bugs": {
    "url": "https://github.com/JHboy203/dsh-plugin-installer/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0",
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
